            sugRepeat:"Wiederholungen vermeiden",sugLetters:"Buchstaben, Zahlen, Symbole mischen"
        }
    };
    let lang = localStorage.getItem('spg_lang') || 'en';
    function t(key){return i18n[lang]?.[key] || i18n.en[key] || key;}

    // ---------- DOM ----------
    const $=s=>document.querySelector(s);
    const passwordInput = $('#password');
    const toggleVis = $('#toggleVis');
    const strengthFill = $('#strengthFill');
    const strengthLabel = $('#strengthLabel');
    const suggestionsBox = $('#suggestionsBox');
    const sugList = $('#sugList');
    const criteriaGrid = $('#criteriaGrid');
    const breachStatus = $('#breachStatus');
    const prefsPanel = $('#prefsPanel');
    const analyticsDash = $('#analyticsDash');
    const toggleAnalytics = $('#toggleAnalytics');
    const toast = $('#toast');
    const srAnnounce = $('#srAnnounce');
    const darkToggle = $('#darkToggle');
    const darkIcon = $('#darkIcon');
    const darkLabel = $('#darkLabel');
    const langSelect = $('#langSelect');
    const copyBtn = $('#copyBtn');

    // ---------- STATE ----------
    let isDark = localStorage.getItem('spg_dark')==='true';
    let analytics = JSON.parse(localStorage.getItem('spg_analytics')) || {checks:0,gen:0,breach:0,copy:0};
    let breachTimer;

    function saveAnalytics(){ localStorage.setItem('spg_analytics',JSON.stringify(analytics)); updateStats(); }
    function updateStats(){
        $('#statChecks').textContent=analytics.checks; $('#statGen').textContent=analytics.gen;
        $('#statBreach').textContent=analytics.breach; $('#statCopy').textContent=analytics.copy;
    }

    function setDark(on){
        isDark=on; document.documentElement.setAttribute('data-theme',on?'dark':'light');
        darkIcon.textContent=on?'☀️':'🌙'; darkLabel.textContent=on?t('light'):t('dark');
        localStorage.setItem('spg_dark',on?'true':'false');
    }

    function applyLang(){
        document.querySelectorAll('[data-i18n]').forEach(el=>{
            if(el.hasAttribute('data-i18n-placeholder')) el.placeholder=t(el.getAttribute('data-i18n-placeholder'));
            else el.textContent=t(el.getAttribute('data-i18n'));
        });
        // Update toggle analytics text
        toggleAnalytics.textContent = analyticsDash.classList.contains('show') ? t('hideStats') : t('showStats');
        darkLabel.textContent = isDark?t('light'):t('dark');
        // If there was a breach status, update its text based on class
        const cls = [...breachStatus.classList].find(c=>['breach-safe','breach-pwned','breach-loading'].includes(c));
        if(cls==='breach-safe') breachStatus.textContent=t('breachSafe');
        else if(cls==='breach-pwned') breachStatus.textContent=t('breachPwned');
        else if(cls==='breach-loading') breachStatus.textContent=t('breachChecking');
        if(!passwordInput.value) strengthLabel.textContent=t('enterPassword');
    }

    function announce(msg){ srAnnounce.textContent=''; setTimeout(()=>srAnnounce.textContent=msg,10); }
    function showToast(msg){ toast.textContent=msg; toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'),2500); }

    function analyzePassword(pwd){
        const checks = {
            length: pwd.length>=8, upper:/[A-Z]/.test(pwd), lower:/[a-z]/.test(pwd),
            number:/[0-9]/.test(pwd), special:/[!@#$%^&*(),.?":{}|<>]/.test(pwd)
        };
        const map = {length:'crit-length',upper:'crit-upper',lower:'crit-lower',number:'crit-number',special:'crit-special'};
        Object.keys(checks).forEach(k=>{
            const el=$('#'+map[k]); const icon=el.querySelector('.criteria-icon');
            if(checks[k]){ el.classList.add('valid'); el.classList.remove('invalid'); icon.textContent='✅'; }
            else{ el.classList.add('invalid'); el.classList.remove('valid'); icon.textContent='❌'; }
        });
        let score=0; if(checks.length)score++; if(checks.upper)score++; if(checks.lower)score++;
        if(checks.number)score++; if(checks.special)score++; if(pwd.length>=12)score++; if(pwd.length>=16)score++;
        let strength,color,pct;
        if(score>=6){ strength=t('strengthVeryStrong'); color='#38a169'; pct=100; }
        else if(score>=5){ strength=t('strengthStrong'); color='#48bb78'; pct=80; }
        else if(score>=3){ strength=t('strengthModerate'); color='#ecc94b'; pct=60; }
        else if(score>=2){ strength=t('strengthWeak'); color='#ed8936'; pct=40; }
        else{ strength=t('strengthWeak'); color='#f56565'; pct=20; }
        strengthFill.style.width=pct+'%'; strengthFill.style.backgroundColor=color;
        strengthLabel.textContent=`Password Strength: ${strength}`; strengthLabel.style.color=color;
        const suggestions=[];
        if(!checks.length)suggestions.push(t('sugLength')); if(!checks.upper)suggestions.push(t('sugUpper'));
        if(!checks.lower)suggestions.push(t('sugLower')); if(!checks.number)suggestions.push(t('sugNumber'));
        if(!checks.special)suggestions.push(t('sugSpecial')); if(pwd.length<12&&checks.length)suggestions.push(t('sugLonger'));
        if(/(.)\1{2,}/.test(pwd))suggestions.push(t('sugRepeat')); if(/^[a-zA-Z]+$/.test(pwd))suggestions.push(t('sugLetters'));
        if(suggestions.length && pwd.length){ sugList.innerHTML=suggestions.map(s=>`<li>${s}</li>`).join(''); suggestionsBox.classList.add('show'); }
        else suggestionsBox.classList.remove('show');
        return {score,checks};
    }

    async function sha1(msg){const buf=new TextEncoder().encode(msg);const hash=await crypto.subtle.digest('SHA-1',buf);return Array.from(new Uint8Array(hash)).map(b=>b.toString(16).padStart(2,'0')).join('');}
    async function checkBreach(pwd){
        if(!pwd){breachStatus.className='breach-status breach-hidden';return;}
        breachStatus.className='breach-status breach-loading';breachStatus.textContent=t('breachChecking');
        try{
            const hash=await sha1(pwd);const prefix=hash.substring(0,5);const suffix=hash.substring(5).toUpperCase();
            const res=await fetch(`https://api.pwnedpasswords.com/range/${prefix}`);
            if(!res.ok)throw new Error('network');
            const data=await res.text();const found=data.split('\n').some(l=>l.split(':')[0].trim()===suffix);
            if(found){
                breachStatus.className='breach-status breach-pwned';breachStatus.textContent=t('breachPwned');
                analytics.breach++;saveAnalytics();announce(t('breachPwned'));
            }else{
                breachStatus.className='breach-status breach-safe';breachStatus.textContent=t('breachSafe');
                announce(t('breachSafe'));
            }
        }catch(e){
            breachStatus.className='breach-status breach-loading';breachStatus.textContent=t('breachError');
        }
    }

    function generate(){
        const len=+$('#prefLen').value;
        const up=$('#prefUpper').checked, low=$('#prefLower').checked, num=$('#prefNum').checked, sym=$('#prefSym').checked;
        let charset=''; const sets=[];
        if(up){charset+='ABCDEFGHIJKLMNOPQRSTUVWXYZ';sets.push('ABCDEFGHIJKLMNOPQRSTUVWXYZ');}
        if(low){charset+='abcdefghijklmnopqrstuvwxyz';sets.push('abcdefghijklmnopqrstuvwxyz');}
        if(num){charset+='0123456789';sets.push('0123456789');}
        if(sym){charset+='!@#$%^&*()_+-=[]{}|;:,.<>?';sets.push('!@#$%^&*()_+-=[]{}|;:,.<>?');}
        if(!sets.length){showToast(t('noChars'));return;}
        let pwd=''; sets.forEach(s=>pwd+=s[Math.floor(Math.random()*s.length)]);
        while(pwd.length<len)pwd+=charset[Math.floor(Math.random()*charset.length)];
        pwd=pwd.split('').sort(()=>Math.random()-0.5).join('');
        passwordInput.value=pwd; passwordInput.type='text'; toggleVis.textContent='🙈';
        analyzePassword(pwd); analytics.gen++; saveAnalytics();
        if($('#autoBreach').checked) checkBreach(pwd);
    }

    async function copy(){
        if(!passwordInput.value){showToast(t('noPass'));return;}
        try{await navigator.clipboard.writeText(passwordInput.value);}catch(e){passwordInput.select();document.execCommand('copy');}
        showToast(t('copied')); analytics.copy++; saveAnalytics();
        copyBtn.classList.add('copied'); setTimeout(()=>copyBtn.classList.remove('copied'),2000);
    }

    // ---------- EVENT LISTENERS ----------
    darkToggle.onclick=()=>setDark(!isDark);
    langSelect.value=lang; langSelect.onchange=()=>{lang=langSelect.value;localStorage.setItem('spg_lang',lang);applyLang();if(passwordInput.value)analyzePassword(passwordInput.value);};
    toggleVis.onclick=()=>{const isPass=passwordInput.type==='password';passwordInput.type=isPass?'text':'password';toggleVis.textContent=isPass?'🙈':'👁️';};
    passwordInput.oninput=()=>{
        const v=passwordInput.value;
        if(v){
            analyzePassword(v);
            if($('#autoBreach').checked){clearTimeout(breachTimer);breachTimer=setTimeout(()=>checkBreach(v),600);}
        }else{
            strengthFill.style.width='0%'; strengthLabel.textContent=t('enterPassword'); strengthLabel.style.color='';
            suggestionsBox.classList.remove('show'); breachStatus.className='breach-status breach-hidden';
            criteriaGrid.querySelectorAll('.criteria-item').forEach(el=>{el.classList.add('invalid');el.classList.remove('valid');el.querySelector('.criteria-icon').textContent='❌';});
        }
    };
    $('#checkBtn').onclick=()=>{if(passwordInput.value){analyzePassword(passwordInput.value);analytics.checks++;saveAnalytics();strengthFill.style.transform='scaleY(1.8)';setTimeout(()=>strengthFill.style.transform='',200);announce('Password checked');}};
    $('#genBtn').onclick=()=>{prefsPanel.classList.toggle('show');if(prefsPanel.classList.contains('show'))generate();};
    copyBtn.onclick=copy;
    $('#breachBtn').onclick=()=>{if(passwordInput.value)checkBreach(passwordInput.value);};
    $('#autoBreach').onchange=function(){if(this.checked&&passwordInput.value)checkBreach(passwordInput.value);else if(!this.checked){breachStatus.className='breach-status breach-hidden';}};
    toggleAnalytics.onclick=()=>{analyticsDash.classList.toggle('show');toggleAnalytics.textContent=analyticsDash.classList.contains('show')?t('hideStats'):t('showStats');};
    $('#prefLen').oninput=()=>{$('#lenVal').textContent=$('#prefLen').value;savePrefs();};
    ['prefUpper','prefLower','prefNum','prefSym'].forEach(id=>$('#'+id).onchange=savePrefs);
    function savePrefs(){
        localStorage.setItem('spg_prefs',JSON.stringify({
            upper:$('#prefUpper').checked, lower:$('#prefLower').checked,
            num:$('#prefNum').checked, sym:$('#prefSym').checked, len:$('#prefLen').value
        }));
    }
    function loadPrefs(){
        const p=JSON.parse(localStorage.getItem('spg_prefs'));
        if(p){
            $('#prefUpper').checked=p.upper!==false; $('#prefLower').checked=p.lower!==false;
            $('#prefNum').checked=p.num!==false; $('#prefSym').checked=p.sym!==false;
            $('#prefLen').value=p.len||16;
        }
        $('#lenVal').textContent=$('#prefLen').value;
    }

    // Init
    setDark(isDark);
    loadPrefs();
    updateStats();
    applyLang();
    console.log('✅ SecurePassGuard ready');
})();
</script>
</body>
