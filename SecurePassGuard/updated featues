            showStats:"📊 Statistiken",hideStats:"📊 Ausblenden",statChecks:"Prüfungen",statGen:"Generiert",statBreach:"Lecks",
            statCopy:"Kopiert",tipsTitle:"🔐 Tipps",tip1:"12+ Zeichen",tip2:"Nicht wiederverwenden",tip3:"Passwort-Manager",
            tip4:"Keine persönlichen Daten",tip5:"2FA aktivieren",dark:"Dunkel",light:"Hell",copied:"Passwort kopiert!",
            noPass:"Zuerst Passwort eingeben",noChars:"Mindestens einen Typ wählen",breachSafe:"✅ Kein Leck",
