            tip3:"Use a password manager",tip4:"Avoid personal info",tip5:"Enable 2FA",dark:"Dark",light:"Light",
            copied:"Password copied!",noPass:"Enter or generate a password first",noChars:"Select at least one character type",
            breachSafe:"✅ Not found in breaches",breachPwned:"❌ Compromised!",breachError:"⚠️ Check failed",breachChecking:"⏳ Checking...",
